{
  "manifest_version": 3,
  "name": "Canvas SpeedGrader Sticky Panels",
  "version": "0.1.0",
  "description": "Keep submission files and comments visible while grading a long rubric.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
